@page "/"
@using GameStore.Frontend.Models
@using Clients;
<PageTitle>Game Store</PageTitle>

<table class="table table-striped table-bordred table-hover mt-3">
    <thead class="table-dark">
        <th>Id</th>
        <th>Name</th>
        <th>Genre</th>
        <th class="text-end">Price</th>
        <th>Release Date</th>
        <th></th>
    </thead>
    <tbody>
        @foreach (var game in games)
        {
            <tr>
                <td>@game.Id</td>
                <td>@game.Name</td>
                <td>@game.Genre</td>
                <td class="text-end">@game.Price.ToString("C2")</td>
                <td>@game.ReleaseDate</td>
                <td></td>
            </tr>
        }
    </tbody>
</table>
@code {
    private GamesClient client = new();
    private GameSummary[]? games;
}